# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://propertygram:propertygram@localhost:5432/propertygram
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=5

# Leave these blank to keep OTP codes printing to the console instead of
# sending real email. Fill them in to send real OTP emails via Gmail SMTP.
# SMTP_PASSWORD must be a Gmail "App Password", not your normal password —
# see https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=PropertyGram
